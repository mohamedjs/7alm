          "combinator": "and",
          "conditions": [
            {
              "id": "a1b2c301-0000-4a00-8000-000000000003",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ ($json.data || []).length }}",
              "rightValue": 0
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c301-0000-4a00-8000-000000000004",
      "name": "Has Any?",
      "type": "n8n-nodes-base.if",
      "position": [
        -2112,
        -1600
      ],
      "typeVersion": 2.2,
      "notes": "Fail-soft: 'Load Pending Ideas' uses neverError, so an auth failure returns {success:false,error} with no 'data' key. Strict validation on an array operator would throw there instead of exiting quietly, so this counts ($json.data || []).length instead."
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
