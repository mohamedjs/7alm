# 7alm production environment — copy to .env.production on the server and fill in.
# Never commit the filled file. Generate secrets with:  openssl rand -hex 32

# ── Domain / TLS ─────────────────────────────────────────────
DOMAIN=shop.example.com
ACME_EMAIL=ops@example.com

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=halm
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=halm

# ── Auth & crypto (required) ─────────────────────────────────
JWT_SECRET=change-me-64-hex-chars
SOCIAL_TOKEN_ENCRYPTION_KEY=change-me-64-hex-chars
REVIEW_TOKEN_SECRET=change-me-64-hex-chars
# First admin, created on first boot only when the admins table is empty (min 12 chars).
ADMIN_SEED_EMAIL=owner@example.com
ADMIN_SEED_PASSWORD=change-me-strong-password

# ── Meta (Facebook Page, Instagram, WhatsApp Cloud API) ──────
# Webhook callback URL to paste into the Meta app:  https://$DOMAIN/api/webhooks/meta
META_GRAPH_VERSION=v27.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=change-me-random
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional explicit tokens (otherwise use Admin → Connections → Facebook / WhatsApp)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
# Approved template used to reopen a WhatsApp chat after the 24 h window (optional)
META_WHATSAPP_FALLBACK_TEMPLATE=
META_WHATSAPP_TEMPLATE_LANG=ar
SOCIAL_MOCK_MODE=0

# ── Shipping ─────────────────────────────────────────────────
DEFAULT_SHIPPING_PROVIDER=bosta
BOSTA_API_KEY=
SHIPPING_WEBHOOK_SECRET=change-me-random

# ── Notifications ────────────────────────────────────────────
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=
EMAIL_FROM=onboarding@resend.dev

# ── n8n automations ──────────────────────────────────────────
N8N_API_ACCESS_TOKEN=change-me-random
N8N_WEBHOOK_SECRET=change-me-random
N8N_ORDER_WEBHOOK_URL=
N8N_WHATSAPP_SEND_WEBHOOK_URL=
N8N_SEND_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=

# ── AI Studio ────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_WEBHOOK_SECRET=
OPENROUTER_VIDEO_CALLBACK_URL=
TELEGRAM_BOT_TOKEN=

# ── Web ──────────────────────────────────────────────────────
NEXT_PUBLIC_IPINFO_TOKEN=
LOG_LEVEL=info
