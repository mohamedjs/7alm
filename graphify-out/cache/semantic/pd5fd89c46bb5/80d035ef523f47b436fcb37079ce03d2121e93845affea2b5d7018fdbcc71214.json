/commerce-growth-phase.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OrderDetailsDrawer already derives a discount from compare_at_price; once explicit discount_amount/coupon_code exist, the two must be reconciled into one coherent discount line, preferring the explicit coupon line, to avoid double-counting."}], "edges": [{"source": "docs_specs_commerce_growth_phase_document", "target": "docs_specs_commerce_growth_phase_product_reviews_workstream", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/commerce-growth-phase.md", "source_location": null, "weight": 1.0}, {"source": "docs_specs_commerce_growth_phase_document", "target": "docs_specs_commerce_growth_phase_review_request_automation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/commerce-growth-phase.md", "source_location": null, "weight": 1.0}, {"source": "docs_specs_commerce_growth_phase_document", "target": "docs_specs_commerce_growth_phase_coupons_workstream", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/commerce-growth-phase.md", "source_location": null, "weight": 1.0}, {"source": "docs_specs_commerce_growth_phase_document", "target": "docs_specs_commerce_growth_phase_search_workstream", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/commerce-growth-phase.md", "source_location": null, "weight": 1.0}, {"source": "docs_specs_commerce_growth_phase_document", "target": "src_features_shipping_shipping_factory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/commerce-growth-phase.md", "source_location": null, "weight": 1.0}, {"source": "docs_specs_commerce_growth_phase_document", "target": "src_lib_auth", "relation": "references", "confidence": "EXTRAC