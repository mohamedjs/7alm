{"nodes": [{"id": "specify_memory_constitution_overview", "label": "7alm Constitution v1.1.0", "file_type": "document", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specify_memory_constitution_layered_architecture", "label": "Principle I: Layered Architecture (NON-NEGOTIABLE)", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every domain MUST flow Repository -> Service -> API route -> RTK Query -> Hooks -> Components; client components must not import supabase.ts, repositories, or services since those run server-side only and would crash the client bundle or leak service-role credentials."}, {"id": "specify_memory_constitution_typescript_strict_always_green", "label": "Principle II: TypeScript Strict, Always Green", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npx tsc --noEmit MUST pass before any change is done, npm run build MUST succeed before deployment-ready; no `any` escape hatches to silence errors."}, {"id": "specify_memory_constitution_rtl_i18n_correctness", "label": "Principle III: RTL/i18n Correctness", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any surface that can render dir=\"rtl\" must use logical CSS properties instead of physical ones, with zero exceptions; direction is now a runtime toggle so both LTR/RTL states must work, not just the one tested."}, {"id": "specify_memory_constitution_no_business_logic_in_components", "label": "Principle IV: No Business Logic in Components", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pages and components are declarative rendering only; data fetching, validation, derived state, and formatting rules live in hooks (client) or services (server)."}, {"id": "specify_memory_constitution_reuse_existing_primitives", "label": "Principle V: Reuse Existing Primitives Over New Dependencies", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI work must reuse existing chart primitives and CRUD form/list/modal patterns instead of introducing new charting/UI libraries, unless the existing primitive genuinely cannot express the requirement."}, {"id": "specify_memory_constitution_preserve_state_machine_factory_contracts", "label": "Principle VI: Preserve State Machine & Factory Contracts", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "orderStateMachine.ts and shipping.factory.ts are the single source of truth for order-status transitions and shipping-provider selection; features must never re-implement status logic inline or hardcode a shipping provider branch."}], "edges": [{"source": "specify_memory_constitution_overview", "target": "specify_templates_constitution_template_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".specify/memory/constitution.md", "source_location": null, "weight": 1.0}, {"source": "specify_memory_constitution_layered_architecture", "target": "agents_repository_pattern", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".specify/memory/constitution.md", "source_location": nu